<Window x:Class="Bevasarlo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Bevasarlo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Bevásárlólista" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="ShoppingListBox" Height="300" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ItemTextBox" Width="200" Margin="0,0,10,0"/>
                <Button x:Name="AddItemButton" Content="Hozzáadás" Click="AddItemButton_Click"/>
                <Button x:Name="RemoveItemButton" Content="Törlés" Click="RemoveItemButton_Click" Margin="10,0,0,0"/>
                <Button x:Name="RemoveAllButton" Content="Összes törlése" Click="RemoveAllButton_Click" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
